# =========================================================================
# MRCPCH Study Platform - Environment Settings
# =========================================================================
#
# ZERO CONFIGURATION REQUIRED! 
# The application runs fully functional inside your browser using an 
# offline fallback state database (LocalStorage) if no backend is deployed.
#
# Only the following optional settings are used for production:

# Port for local development
PORT=3000

# Optional: Custom encryption key for backend JWT session tokens (Cloudflare Worker only)
# Falls back to a secure default if not specified.
JWT_SECRET="mrcpch_study_platform_default_key_32_chars_long"
