# ==========================================
# MRCPCH Study Platform Environment Variables
# ==========================================

# Port for local development
PORT=3000

# JWT Auth Secrets (Worker / API)
JWT_SECRET="your_jwt_secret_minimum_32_characters_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_minimum_32_characters_here"
JWT_EXPIRATION="86400" # 24 hours in seconds

# Google OAuth Credentials (for Student & Admin sign-in)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Cloudflare D1 Database Configuration (Local dev environment uses sqlite built-in wrangler)
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"
D1_DATABASE_ID="00000000-0000-0000-0000-000000000000"

# Cloudflare R2 Upload Buckets
R2_BUCKET_NAME="mrcpch-materials-bucket"
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"

# Cloudflare KV Caching Bindings
KV_NAMESPACE_ID="00000000000000000000000000000000"

# Cloudflare Turnstile Bot Protection
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Gemini API Key for server-side clinical tutoring and explanations
GEMINI_API_KEY=
