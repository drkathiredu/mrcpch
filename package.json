{
  "name": "mrcpch-study-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "dev": "npm --prefix frontend run dev",
    "preview": "npm --prefix frontend run preview",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy",
    "typecheck": "npm --prefix frontend run typecheck && npm --prefix worker run typecheck",
    "lint": "npm run typecheck",
    "db:migrate:local": "wrangler d1 execute mrcpch_db --local --file=database/schema.sql",
    "db:seed:local": "wrangler d1 execute mrcpch_db --local --file=database/seeds/seed.sql"
  },
  "devDependencies": {
    "wrangler": "^3.109.0"
  }
}
